{
  "name": "patch-notes-live",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces",
    "lint": "eslint .",
    "build": "tsc -b && npm run build:template -w @patch-notes-live/server",
    "format": "prettier --write .",
    "dev": "node scripts/dev.mjs",
    "patch:apply": "node scripts/server.mjs apply",
    "patch:revert": "node scripts/server.mjs revert",
    "verify": "node packages/harness/verify.mjs",
    "patch": "node packages/server/patch.mjs",
    "bench": "node scripts/bench.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "eslint": "^9.39.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.0"
  }
}
